{
  "info": {
    "_postman_id": "b28c125c-8f8f-4b9a-9a17-51ca7064b154",
    "name": "MyTasks Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "auth.postman.demo@example.com"
    },
    {
      "key": "password",
      "value": "Postman-Demo-Only-2026!"
    }
  ],
  "item": [
    {
      "name": "Register new account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('register returns 201', function () { pm.response.to.have.status(201); });",
              "pm.test('registration response excludes credentials', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.email).to.eql(pm.variables.get('email'));",
              "  pm.expect(body).not.to.have.property('password');",
              "  pm.expect(body).not.to.have.property('passwordHash');",
              "  pm.collectionVariables.set('userId', body.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('duplicate registration returns 409', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login with correct password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns a JWT', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
              "  pm.expect(body).not.to.have.property('password');",
              "  pm.expect(body).not.to.have.property('passwordHash');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login with wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Wrong-Password-2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('wrong password returns 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    }
  ]
}