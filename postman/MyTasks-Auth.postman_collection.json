{
  "info": {
    "_postman_id": "b28c125c-8f8f-4b9a-9a17-51ca7064b154",
    "name": "MyTasks Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "alice@test.dev"
    },
    {
      "key": "password",
      "value": "secret123"
    }
  ],
  "item": [
    {
      "name": "Signup new account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/signup"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('signup returns 201', function () { pm.response.to.have.status(201); });",
              "pm.test('signup response excludes credentials', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.email).to.eql(pm.variables.get('email'));",
              "  pm.expect(body).to.have.property('id');",
              "  pm.expect(body).not.to.have.property('password');",
              "  pm.expect(body).not.to.have.property('passwordHash');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Signup duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/signup"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('duplicate signup returns 409', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login with correct password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns an accessToken', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('accessToken', body.accessToken);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login with wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrongpass\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('wrong password returns 401', function () { pm.response.to.have.status(401); });",
              "pm.test('message is Invalid credentials', function () {",
              "  pm.expect(pm.response.json().message).to.eql('Invalid credentials');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List todos without token (401)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/todos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('todos without a token return 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List todos with token (200)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/todos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('todos with a token return 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh access token",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/refresh"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refresh returns a new accessToken', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logout returns 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}
