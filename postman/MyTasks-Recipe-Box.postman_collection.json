{
  "info": {
    "_postman_id": "b9d1c5e1-34a0-4c33-9a7b-3417d7619f21",
    "name": "MyTasks Recipe Box Capstone",
    "description": "Exercises public recipe reads, validated JWT-protected CRUD, missing-item errors, and unauthenticated write rejection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "Recipe-demo-2026!" },
    { "key": "accessToken", "value": "" },
    { "key": "recipeId", "value": "" }
  ],
  "item": [
    {
      "name": "1. List recipes (public)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('public recipe list returns an array', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/recipes"
      }
    },
    {
      "name": "2. Get missing recipe (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('missing recipe returns 404', function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/recipes/2147483647"
      }
    },
    {
      "name": "3. Register a fresh demo account",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('email', `recipe.${Date.now()}@test.dev`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('signup succeeds without exposing password hash', function () {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json()).not.to.have.property('passwordHash');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/signup"
      }
    },
    {
      "name": "4. Log in and save token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns a JWT', function () {",
              "  pm.response.to.have.status(200);",
              "  const token = pm.response.json().accessToken;",
              "  pm.expect(token).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('accessToken', token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "5. Create without a token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('write without a token is rejected', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Pancakes\",\"ingredients\":\"Flour, eggs, milk\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/recipes"
      }
    },
    {
      "name": "6. Update missing recipe (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('updating a missing recipe returns 404', function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Missing recipe\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/recipes/2147483647"
      }
    },
    {
      "name": "7. Delete missing recipe (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('deleting a missing recipe returns 404', function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/recipes/2147483647"
      }
    },
    {
      "name": "8. Create with an empty required field (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('validation rejects an empty required name', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"\",\"ingredients\":\"Flour, eggs, milk\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/recipes"
      }
    },
    {
      "name": "9. Create a recipe with token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('recipe is created and ID is saved', function () {",
              "  pm.response.to.have.status(201);",
              "  const recipe = pm.response.json();",
              "  pm.expect(recipe.name).to.eql('Pancakes');",
              "  pm.expect(recipe.isFavorite).to.eql(false);",
              "  pm.collectionVariables.set('recipeId', String(recipe.id));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Pancakes\",\"ingredients\":\"Flour, eggs, milk\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/recipes"
      }
    },
    {
      "name": "10. Get the created recipe (public)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('recipe details are returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('recipeId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/recipes/{{recipeId}}"
      }
    },
    {
      "name": "11. Update recipe with token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('recipe is updated', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().isFavorite).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"isFavorite\":true}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/recipes/{{recipeId}}"
      }
    },
    {
      "name": "12. Delete recipe with token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('recipe is deleted', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/recipes/{{recipeId}}"
      }
    },
    {
      "name": "13. Get deleted recipe (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('deleted recipe is now missing', function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/recipes/{{recipeId}}"
      }
    }
  ]
}
