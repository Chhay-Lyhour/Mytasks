{
  "info": {
    "_postman_id": "12d18d7c-322e-47c2-9ef1-f81caa743c5e",
    "name": "MyTasks AuthN and AuthZ Lab",
    "description": "Runs the two-user authentication, authorization, refresh, and logout lab against the local API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "aliceEmail",
      "value": ""
    },
    {
      "key": "bobEmail",
      "value": ""
    },
    {
      "key": "password",
      "value": "secret123"
    },
    {
      "key": "aliceAccessToken",
      "value": ""
    },
    {
      "key": "bobAccessToken",
      "value": ""
    },
    {
      "key": "aliceId",
      "value": ""
    },
    {
      "key": "bobTodoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sign up Alice",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString();",
              "pm.collectionVariables.set('aliceEmail', `alice.${runId}@test.dev`);",
              "pm.collectionVariables.set('bobEmail', `bob.${runId}@test.dev`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Alice signup returns 201 and no password hash', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.email).to.eql(pm.collectionVariables.get('aliceEmail'));",
              "  pm.expect(body.id).to.be.a('number');",
              "  pm.expect(body).not.to.have.property('password');",
              "  pm.expect(body).not.to.have.property('passwordHash');",
              "  pm.collectionVariables.set('aliceId', String(body.id));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{aliceEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/signup"
      }
    },
    {
      "name": "2. Sign up Alice again (expect 409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('duplicate signup returns 409 Conflict', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{aliceEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/signup"
      }
    },
    {
      "name": "3. Alice login with wrong password (expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('wrong password returns 401 Unauthorized', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{aliceEmail}}\",\n  \"password\": \"wrong-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "4. Alice login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Alice login returns an access token', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('aliceAccessToken', body.accessToken);",
              "});",
              "pm.test('refresh token is set as an HttpOnly cookie', function () {",
              "  pm.expect(pm.response.headers.get('Set-Cookie')).to.include('HttpOnly');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{aliceEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "5. Get todos without a token (expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('protected todo list rejects an unauthenticated request', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/todos"
      }
    },
    {
      "name": "6. Create Alice's todo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Alice todo is owned by Alice', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.ownerId).to.eql(Number(pm.collectionVariables.get('aliceId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{aliceAccessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Alice's private lab todo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/todos"
      }
    },
    {
      "name": "7. Sign up Bob",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Bob signup returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('bobEmail'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{bobEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/signup"
      }
    },
    {
      "name": "8. Bob login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Bob login returns an access token', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('bobAccessToken', body.accessToken);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{bobEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "9. Create Bob's todo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Bob todo is owned by Bob', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('bobTodoId', String(body.id));",
              "  pm.expect(body.ownerId).not.to.eql(Number(pm.collectionVariables.get('aliceId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{bobAccessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Bob's private lab todo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/todos"
      }
    },
    {
      "name": "10. Alice only sees Alice's todos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Alice list excludes Bob todos', function () {",
              "  pm.response.to.have.status(200);",
              "  const todos = pm.response.json();",
              "  const aliceId = Number(pm.collectionVariables.get('aliceId'));",
              "  pm.expect(todos).to.be.an('array').and.not.empty;",
              "  pm.expect(todos.every((todo) => todo.ownerId === aliceId)).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/todos"
      }
    },
    {
      "name": "11. Alice cannot access Bob's todo (expect 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('cross-user todo ID returns 404', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/todos/{{bobTodoId}}"
      }
    },
    {
      "name": "12. Refresh Bob's session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refresh rotates the cookie and returns an access token', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(pm.response.headers.get('Set-Cookie')).to.include('HttpOnly');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/refresh"
      }
    },
    {
      "name": "13. Log out Bob",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logout succeeds and clears the refresh cookie', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Set-Cookie')).to.include('refreshToken=');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/logout"
      }
    },
    {
      "name": "14. Refresh after logout (expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logged-out refresh token is rejected', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/refresh"
      }
    }
  ]
}
